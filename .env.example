# Sao chép thành .env (không commit) rồi điền giá trị thật. Bỏ trống = dùng mặc định trong docker-compose.yml / application.yaml.

# Cơ sở dữ liệu trong container MySQL
MYSQL_DATABASE=elsa_store_db
MYSQL_USER=elsa_user
MYSQL_PASSWORD=elsa_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8080

# Khoá ký JWT HS512 — tối thiểu 64 ký tự ngẫu nhiên khi triển khai thật
JWT_SIGNER_KEY=

# Địa chỉ API mà điện thoại mở được (link trong email, VNPay trả về)
APP_PUBLIC_URL=http://localhost:8080/elsa-store/api

# VNPay (bỏ trống = tài khoản sandbox)
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_URL=

# Gmail: bật xác minh 2 bước rồi tạo App Password
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Firebase (push): đặt file vào ./secrets/ rồi ghi đường dẫn trong container
FIREBASE_CREDENTIALS=

# Trợ lý AI
GEMINI_API_KEY=
